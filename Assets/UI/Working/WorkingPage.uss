/* 作業中ページ (ARグラス連携モード) のスタイル */

.working {
    flex-grow: 1;
}

/* 本文 (ダイアログの幕を画面端まで広げるため、paddingと中央寄せはこちらに持たせる) */
.working__body {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 32px;
    padding-right: 32px;
}

.working__logo {
    width: 140px;
    height: 52px;
    background-image: url("/Assets/Sprites/CanbatsuLogo.png");
    background-size: contain;
    background-repeat: no-repeat;
    margin-bottom: 28px;
}

/* ---- 動作中パルス (緑の輪が広がるアニメーション) ---- */

.working__pulse-area {
    width: 120px;
    height: 120px;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
}

.working__pulse-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 80px;
    height: 80px;
    border-radius: 40px;
    border-width: 3px;
    border-color: rgb(124, 194, 66);
    translate: -50% -50%;
}

.working__pulse-core {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgb(27, 152, 60);
}

.working__title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(27, 152, 60);
}

.working__subtitle {
    font-size: 13px;
    color: rgb(100, 100, 100);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ---- XREAL Eyeカメラのプレビュー ---- */

.working__eye-preview {
    align-self: stretch;
    height: 170px;
    margin-top: 14px;
    border-radius: 12px;
    background-color: rgb(24, 28, 26);
    overflow: hidden;
}

.working__eye-status {
    font-size: 11px;
    color: rgb(130, 130, 130);
    margin-top: 4px;
    -unity-text-align: middle-center;
}

/* 実施中の計画の概要カード */
.working__card {
    margin-top: 20px;
    align-self: stretch;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 16px;
}

.working__card-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(240, 240, 240);
}

.working__card-key {
    font-size: 13px;
    color: rgb(120, 120, 120);
}

.working__card-value {
    font-size: 13px;
    -unity-font-style: bold;
}

.working__note {
    font-size: 11px;
    color: rgb(130, 130, 130);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.working__finish-button {
    align-self: stretch;
    height: 48px;
    margin: 0;
    border-width: 1px;
    border-color: rgb(210, 90, 80);
    border-radius: 24px;
    background-color: rgb(255, 255, 255);
    color: rgb(200, 60, 50);
    font-size: 15px;
    -unity-font-style: bold;
}

.working__finish-button:hover {
    background-color: rgb(253, 243, 242);
}
