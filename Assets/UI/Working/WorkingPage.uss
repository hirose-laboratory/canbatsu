/* 作業中ページ (ARグラス連携モード) のスタイル */

.working {
    flex-grow: 1;
}

/* 本文 (ダイアログの幕を画面端まで広げるため、paddingと中央寄せはこちらに持たせる) */
.working__body {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 32px;
    padding-right: 32px;
}

.working__logo {
    width: 140px;
    height: 52px;
    background-image: url("/Assets/Sprites/CanbatsuLogo.png");
    background-size: contain;
    background-repeat: no-repeat;
    margin-bottom: 28px;
}

/* ---- 動作中パルス (緑の輪が広がるアニメーション) ---- */

.working__pulse-area {
    width: 120px;
    height: 120px;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
}

.working__pulse-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 80px;
    height: 80px;
    border-radius: 40px;
    border-width: 3px;
    border-color: rgb(124, 194, 66);
    translate: -50% -50%;
}

.working__pulse-core {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgb(27, 152, 60);
}

.working__title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(27, 152, 60);
}

.working__subtitle {
    font-size: 13px;
    color: rgb(100, 100, 100);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ---- XREAL Eyeカメラのプレビュー ---- */

.working__eye-preview {
    align-self: stretch;
    height: 170px;
    margin-top: 14px;
    border-radius: 12px;
    background-color: rgb(24, 28, 26);
    overflow: hidden;
}

.working__eye-status {
    font-size: 11px;
    color: rgb(130, 130, 130);
    margin-top: 4px;
    -unity-text-align: middle-center;
}

/* 実施中の計画の概要カード */
.working__card {
    margin-top: 20px;
    align-self: stretch;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 16px;
}

.working__card-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(240, 240, 240);
}

.working__card-key {
    font-size: 13px;
    color: rgb(120, 120, 120);
}

.working__card-value {
    font-size: 13px;
    -unity-font-style: bold;
}

.working__note {
    font-size: 11px;
    color: rgb(130, 130, 130);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

/* ---- ARグラス操作の代替ボタン (基準点 / マーク) ---- */

.working__ar-actions {
    flex-direction: row;
    align-self: stretch;
    margin-bottom: 12px;
}

.working__ar-action {
    flex-grow: 1;
    height: 44px;
    margin: 0 4px;
    border-width: 1px;
    border-color: rgb(27, 152, 60);
    border-radius: 22px;
    background-color: rgb(255, 255, 255);
    color: rgb(27, 152, 60);
    font-size: 14px;
    -unity-font-style: bold;
}

.working__ar-action:hover {
    background-color: rgb(244, 250, 245);
}

/* マーク = 伐採対象の指定なので赤系で区別する */
.working__ar-action--mark {
    border-color: rgb(210, 90, 80);
    color: rgb(200, 60, 50);
}

.working__ar-action--mark:hover {
    background-color: rgb(253, 243, 242);
}

/* かかり木 = 危険表示なのでオレンジ系。表示中はもう一度押すと解除 (Controllerが文言を切り替える) */
.working__ar-action--kakarigi {
    border-color: rgb(230, 140, 40);
    color: rgb(210, 120, 20);
}

.working__ar-action--kakarigi:hover {
    background-color: rgb(255, 247, 238);
}

.working__finish-button {
    align-self: stretch;
    height: 48px;
    margin: 0;
    border-width: 1px;
    border-color: rgb(210, 90, 80);
    border-radius: 24px;
    background-color: rgb(255, 255, 255);
    color: rgb(200, 60, 50);
    font-size: 15px;
    -unity-font-style: bold;
}

.working__finish-button:hover {
    background-color: rgb(253, 243, 242);
}

/* ---- 作業終了ダイアログの縦積みボタン ---- */

/* 3択なので縦に積む (共通の .dialog__buttons は横並びのため使わない) */
.working__finish-buttons {
    flex-direction: column;
}

.working__finish-choice {
    height: 46px;
    margin: 0 0 8px 0;
    border-radius: 8px;
    font-size: 15px;
}

/* 記録して完了: 計画ごと終える操作。塗りつぶしの「続ける」と区別するため緑の枠にする */
.working__finish-choice--complete {
    border-width: 1px;
    border-color: rgb(27, 152, 60);
    background-color: rgb(255, 255, 255);
    color: rgb(27, 152, 60);
}

.working__finish-choice--complete:hover {
    background-color: rgb(244, 250, 245);
}

/* キャンセル (共通の .dialog__cancel はflex調整が縦積みと合わないため見た目だけ揃えて自前で持つ) */
.working__finish-choice--cancel {
    margin-bottom: 0;
    border-width: 1px;
    border-color: rgb(180, 180, 180);
    background-color: rgb(255, 255, 255);
    color: rgb(80, 80, 80);
    font-size: 14px;
}

.working__finish-choice--cancel:hover {
    background-color: rgb(246, 246, 246);
}
