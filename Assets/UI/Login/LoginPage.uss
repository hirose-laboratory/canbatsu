/* ログインページのスタイル */

.login {
    flex-grow: 1;
    justify-content: center;
    padding-left: 32px;
    padding-right: 32px;
}

/* ロゴ画像 (PDF表紙から抽出した手書き風「CAN伐」) */
.login__logo {
    width: 220px;
    height: 82px;
    background-image: url("/Assets/Sprites/CanbatsuLogo.png");
    background-size: contain;
    background-repeat: no-repeat;
    align-self: center;
    margin-bottom: 8px;
}

.login__subtitle {
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgb(120, 120, 120);
    margin-bottom: 32px;
}

.login__field {
    margin-top: 8px;
    margin-bottom: 8px;
}

/* 状態表示 (ログイン中... / エラーメッセージ) */
.login__status {
    min-height: 18px;
    margin-top: 8px;
    font-size: 12px;
    color: rgb(200, 60, 50);
    white-space: normal;
    -unity-text-align: middle-center;
}

.login__button {
    height: 48px;
    margin-top: 12px;
    border-radius: 24px;
    border-width: 0;
    background-color: rgb(27, 152, 60);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.login__button:hover {
    background-color: rgb(23, 130, 51);
}

.login__button:active {
    background-color: rgb(19, 108, 43);
}

/* 新規登録 (アウトラインの控えめなボタン) */
.login__register-button {
    height: 44px;
    margin-top: 10px;
    border-radius: 22px;
    border-width: 1px;
    border-color: rgb(27, 152, 60);
    background-color: rgb(255, 255, 255);
    color: rgb(27, 152, 60);
    font-size: 14px;
}

.login__register-button:hover {
    background-color: rgb(244, 250, 245);
}
