/* 予定ページのスタイル */

.home {
    flex-grow: 1;
}

/* ---- 空の状態 ---- */

.home__empty {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
}

/* +入りアイコン (画像ではなくVisualElement+USSで描画する規約) */
.home__empty-icon {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    background-color: rgb(214, 214, 214);
    margin-bottom: 20px;
}

.home__empty-icon-frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 38px;
    height: 38px;
    border-width: 4px;
    border-color: rgb(20, 20, 20);
    border-radius: 8px;
    translate: -50% -50%;
}

.home__empty-icon-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20px;
    height: 4px;
    background-color: rgb(20, 20, 20);
    translate: -50% -50%;
}

.home__empty-icon-bar--vertical {
    rotate: 90deg;
}

.home__empty-title {
    font-size: 22px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.home__empty-subtitle {
    font-size: 13px;
    color: rgb(130, 130, 130);
    -unity-text-align: middle-center;
    margin-bottom: 48px;
}

.home__create-button {
    align-self: stretch;
}

/* ---- 一覧表示 ---- */

.home__sections {
    flex-grow: 1;
}

.home__section-title {
    font-size: 20px;
    margin-top: 12px;
    margin-left: 16px;
    margin-bottom: 8px;
}

/* セクションの中身は白い帯の上にカードを並べる */
.home__section-list {
    background-color: rgb(255, 255, 255);
    padding: 14px 16px 2px 16px;
}

/* ---- 右下のフローティング追加ボタン ---- */

.home__add-button {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 60px;
    height: 60px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 30px;
    background-color: rgb(27, 152, 60);
}

.home__add-button:hover {
    background-color: rgb(23, 130, 51);
}

.home__add-button:active {
    background-color: rgb(19, 108, 43);
}

/* +アイコン (VisualElement 2本のバーで描画) */
.home__add-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30px;
    height: 4px;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
    translate: -50% -50%;
}

.home__add-icon--vertical {
    rotate: 90deg;
}

/* ---- 作業開始の確認ダイアログ ---- */

/* 画面全体を暗くする幕 */
.home__dialog-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: center;
    padding-left: 28px;
    padding-right: 28px;
    display: none;
}

.home__dialog {
    background-color: rgb(255, 255, 255);
    border-radius: 16px;
    padding: 20px;
}

.home__dialog-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.home__dialog-rows {
    margin-bottom: 10px;
}

.home__dialog-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(240, 240, 240);
}

.home__dialog-key {
    font-size: 13px;
    color: rgb(120, 120, 120);
}

.home__dialog-value {
    font-size: 13px;
    -unity-font-style: bold;
}

.home__dialog-note {
    font-size: 11px;
    color: rgb(130, 130, 130);
    white-space: normal;
    margin-bottom: 14px;
}

/* 範囲の再設定 (編集ダイアログから計画作成ページの地図へ) */
.home__dialog-range {
    height: 42px;
    margin: 10px 0 12px 0;
    border-width: 1px;
    border-color: rgb(27, 152, 60);
    border-radius: 8px;
    background-color: rgb(255, 255, 255);
    color: rgb(27, 152, 60);
    font-size: 14px;
}

.home__dialog-range:hover {
    background-color: rgb(244, 250, 245);
}

.home__dialog-buttons {
    flex-direction: row;
}

.home__dialog-cancel {
    flex-grow: 1;
    flex-basis: 0;
    height: 46px;
    margin: 0 8px 0 0;
    border-width: 1px;
    border-color: rgb(180, 180, 180);
    border-radius: 8px;
    background-color: rgb(255, 255, 255);
    color: rgb(80, 80, 80);
    font-size: 14px;
}

.home__dialog-start {
    flex-grow: 1;
    flex-basis: 0;
    height: 46px;
    margin: 0;
    font-size: 15px;
}
