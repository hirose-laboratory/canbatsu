/* 作業計画の新規作成ページ (Googleマップ風の全画面地図) */

.plan-create {
    flex-grow: 1;
}

.plan-create__map {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---- 上部バー (戻る + 操作ガイド) ---- */

.plan-create__top-bar {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    flex-direction: row;
    align-items: center;
}

/* Googleマップ風の白い丸ボタン */
.plan-create__round-button {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    border-radius: 22px;
    background-color: rgb(255, 255, 255);
    justify-content: center;
    align-items: center;
}

.plan-create__round-button:hover {
    background-color: rgb(240, 240, 240);
}

/* 戻る矢印 (くの字。VisualElement+USSで描画する規約) */
.plan-create__back-icon {
    width: 18px;
    height: 18px;
}

.plan-create__back-bar {
    position: absolute;
    left: 2px;
    width: 13px;
    height: 3px;
    border-radius: 1.5px;
    background-color: rgb(60, 60, 60);
}

.plan-create__back-bar--up {
    top: 4px;
    rotate: -35deg;
}

.plan-create__back-bar--down {
    top: 11px;
    rotate: 35deg;
}

/* 操作ガイド (検索バー風の白いピル) */
.plan-create__instruction {
    flex-grow: 1;
    margin-left: 10px;
    padding: 8px 16px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    border-radius: 22px;
}

.plan-create__instruction-title {
    font-size: 13px;
    -unity-font-style: bold;
}

.plan-create__instruction-sub {
    font-size: 11px;
    color: rgb(120, 120, 120);
}

/* ---- 頂点を戻すボタン (ガイド直下の白ピル) ---- */

.plan-create__undo-button {
    position: absolute;
    top: 66px;
    right: 12px;
    height: 34px;
    margin: 0;
    padding: 0 14px;
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    border-radius: 17px;
    background-color: rgb(255, 255, 255);
    font-size: 12px;
    color: rgb(60, 60, 60);
    display: none;
}

/* ---- 右側ズームコントロール ---- */

.plan-create__side-controls {
    position: absolute;
    right: 12px;
    bottom: 170px;
    align-items: flex-end;
}

/* ズームの+/-縦グループ (Googleマップ風) */
.plan-create__zoom-group {
    width: 44px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    border-radius: 22px;
}

.plan-create__zoom-button {
    width: 42px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 21px;
    background-color: transparent;
    justify-content: center;
    align-items: center;
}

.plan-create__zoom-button:hover {
    background-color: rgb(240, 240, 240);
}

.plan-create__zoom-divider {
    height: 1px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(220, 220, 220);
}

.plan-create__zoom-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 3px;
    border-radius: 1.5px;
    background-color: rgb(60, 60, 60);
    translate: -50% -50%;
}

.plan-create__zoom-icon--vertical {
    rotate: 90deg;
}

/* ---- 確定ボタン ---- */

.plan-create__confirm-button {
    position: absolute;
    left: 90px;
    right: 16px;
    bottom: 32px;
    display: none;
}

/* ---- 出典表示 ---- */

.plan-create__attribution {
    position: absolute;
    right: 6px;
    bottom: 4px;
    padding: 2px 8px;
    font-size: 10px;
    color: rgb(60, 60, 60);
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 8px;
}

/* ---- 結果シート (下からの白いパネル) ---- */

.plan-create__sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 8px 20px 20px 20px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    display: none;
}

.plan-create__sheet-handle {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background-color: rgb(210, 210, 210);
    align-self: center;
    margin-bottom: 10px;
}

.plan-create__sheet-title {
    font-size: 18px;
    -unity-font-style: bold;
}

.plan-create__sheet-caption {
    font-size: 11px;
    color: rgb(130, 130, 130);
    margin-bottom: 10px;
}

.plan-create__sheet-buttons {
    flex-direction: row;
    margin-top: 12px;
}

.plan-create__sheet-cancel {
    flex-grow: 1;
    flex-basis: 0;
    height: 48px;
    margin: 0 8px 0 0;
    border-width: 1px;
    border-color: rgb(27, 152, 60);
    border-radius: 8px;
    background-color: rgb(255, 255, 255);
    color: rgb(27, 152, 60);
    font-size: 15px;
}

.plan-create__sheet-save {
    flex-grow: 1;
    flex-basis: 0;
    height: 48px;
    margin: 0;
}
